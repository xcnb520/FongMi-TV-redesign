<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/mc_accent_soft">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="@color/mc_accent_hi" android:centerColor="@color/mc_accent" android:endColor="@color/mc_accent_lo" android:type="linear" />
            <corners android:radius="@dimen/mc_radius_md" />
        </shape>
    </item>
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/white" />
            <corners android:radius="@dimen/mc_radius_md" />
        </shape>
    </item>
</ripple>
