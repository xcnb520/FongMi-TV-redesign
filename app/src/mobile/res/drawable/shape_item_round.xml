<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/mc_accent_soft" />
            <corners android:radius="@dimen/mc_radius_pill" />
            <stroke android:width="1dp" android:color="@color/mc_accent_line" />
        </shape>
    </item>
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/mc_accent_soft" />
            <corners android:radius="@dimen/mc_radius_pill" />
            <stroke android:width="1dp" android:color="@color/mc_accent_line" />
        </shape>
    </item>
    <item>
        <ripple android:color="@color/mc_tint_3">
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/mc_tint_1" />
                    <corners android:radius="@dimen/mc_radius_pill" />
                    <stroke android:width="1dp" android:color="@color/mc_line" />
                </shape>
            </item>
            <item android:id="@android:id/mask">
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/white" />
                    <corners android:radius="@dimen/mc_radius_pill" />
                </shape>
            </item>
        </ripple>
    </item>
</selector>
