<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginTop="4dp"
    android:layout_marginEnd="16dp"
    android:layout_marginBottom="4dp"
    android:background="@drawable/mc_item"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingEnd="6dp">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/icon"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginEnd="12dp"
        android:importantForAccessibility="no"
        app:tint="@color/mc_text_2" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:singleLine="true"
        android:textColor="@color/mc_text"
        android:textSize="15sp" />

    <FrameLayout
        android:id="@+id/indicator"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="12dp">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/status"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:visibility="gone"
            app:tint="@color/mc_text" />

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/progress"
            style="@style/Widget.Material3Expressive.CircularProgressIndicator.Wavy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:saveEnabled="false"
            android:visibility="gone"
            app:indicatorColor="@color/mc_accent"
            app:indicatorSize="22dp"
            app:trackThickness="2dp"
            app:wavelength="8dp" />

    </FrameLayout>

</androidx.appcompat.widget.LinearLayoutCompat>
