<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/mc_surface"
    app:cardCornerRadius="@dimen/mc_radius_md"
    app:cardElevation="0dp"
    app:rippleColor="@color/mc_tint_3"
    app:strokeColor="@color/mc_line"
    app:strokeWidth="1dp">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/image"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:background="@color/mc_tint_2"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/Vod.Grid" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/site"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="6dp"
                android:background="@drawable/shape_vod_site"
                android:singleLine="true"
                android:textColor="@color/text_site"
                android:textSize="10sp"
                android:visibility="gone"
                tools:text="泥巴"
                tools:visibility="visible" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/remark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_margin="6dp"
                android:background="@drawable/shape_vod_remark"
                android:singleLine="true"
                android:textColor="@color/text_remark"
                android:textSize="10sp"
                tools:text="1080p" />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/delete"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/mc_overlay"
                android:scaleType="center"
                android:src="@drawable/ic_vod_delete"
                android:visibility="gone"
                tools:visibility="visible" />

        </FrameLayout>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/mc_tint_2"
            app:indicatorColor="@color/mc_accent"
            app:trackColor="@color/transparent"
            app:trackStopIndicatorSize="0dp" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/mc_poster_name"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:minHeight="34dp"
            android:paddingStart="6dp"
            android:paddingTop="7dp"
            android:paddingEnd="6dp"
            android:paddingBottom="7dp"
            android:textColor="@color/mc_text"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="蜘蛛人" />

    </androidx.appcompat.widget.LinearLayoutCompat>

</com.google.android.material.card.MaterialCardView>
